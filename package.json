{
  "name": "dsh-mingyuanhu",
  "version": "0.1.0",
  "description": "四川大学校园服务：在 DeepSeek Harness 中登录并只读查询成绩、课表和电费。",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "AzureKyrielight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzureKyrielight/dsh-mingyuanhu.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scu",
    "campus"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.2.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remote-access"
      ]
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests scripts package.json tsconfig.json README.md NOTICE.md locale cordis.patch.yml",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.2"
  },
  "dependencies": {
    "sm-crypto": "0.5.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/sm-crypto": "^0.3.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.6"
  }
}
